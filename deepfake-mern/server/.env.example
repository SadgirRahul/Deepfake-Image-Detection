PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
PYTHON_EXECUTABLE=python
PYTHON_SCRIPT=model/predict.py

# Optional: force the Python predictor to use your trained weights.
# If this is missing/incorrect, the predictor will now fail fast.
MODEL_PATH=F:/CV_CP/models/best_model.pth

# Optional: override inference settings
# DEVICE=cpu
# IMAGE_SIZE=224
# USE_ELA=true
